<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">Trash Can</h2>
    <p class="text-muted mb-0 small">Items here will be permanently deleted after 30 days.</p>
</div>

<div class="row g-4">
    <% if(notes.length > 0) { %>
        <% notes.forEach(note => { %>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm opacity-75">
                    <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center pt-3 px-3">
                        <span class="badge bg-danger-subtle text-danger small">Deleted</span>
                        <small class="text-muted" style="font-size: 0.7rem;"><%= new Date(note.updatedAt).toLocaleDateString() %></small>
                    </div>
                    <div class="card-body px-3 pb-3">
                        <h5 class="fw-bold mb-2 text-decoration-line-through text-muted"><%= note.title %></h5>
                        <p class="text-muted small mb-3 text-truncate-2">
                            <%= note.description.replace(/<[^>]*>?/gm, '') %>
                        </p>
                        <div class="d-flex gap-2 mt-3">
                            <form action="/notes/restore/<%= note._id %>?_method=PUT" method="POST" class="flex-grow-1">
                                <button type="submit" class="btn btn-success-subtle text-success w-100 btn-sm rounded-pill border-0">
                                    <i data-feather="rotate-ccw" style="width: 14px;"></i> Restore
                                </button>
                            </form>
                            <form action="/notes/<%= note._id %>?_method=DELETE" method="POST" class="flex-grow-1">
                                <button type="submit" class="btn btn-danger-subtle text-danger w-100 btn-sm rounded-pill border-0" onclick="confirmDelete(event)">
                                    <i data-feather="trash-2" style="width: 14px;"></i> Permanently Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    <% } else { %>
        <div class="col-12 text-center py-5 text-muted">
            <i data-feather="trash" class="d-block mx-auto mb-3" style="width: 48px; height: 48px; opacity: 0.2;"></i>
            <p>Your trash is empty.</p>
        </div>
    <% } %>
</div>
