<div class="row">
    <div class="col-lg-10 m-auto">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <h2 class="fw-bold mb-0">Create New Note</h2>
            <a href="/notes" class="btn btn-light rounded-pill">
                <i data-feather="arrow-left"></i> Back to Notes
            </a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <form id="note-form" action="/notes" method="POST" enctype="multipart/form-data" novalidate>
                    <div class="row g-4">
                        <div class="col-md-8">
                            <div class="mb-4">
                                <label for="title" class="form-label fw-bold small text-uppercase">Note Title</label>
                                <input type="text" class="form-control form-control-lg border-0 bg-light" id="title" name="title" placeholder="What's on your mind?" required>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-4">
                                <label for="priority" class="form-label fw-bold small text-uppercase">Priority</label>
                                <select class="form-select border-0 bg-light" id="priority" name="priority">
                                    <option value="Low">Low</option>
                                    <option value="Medium" selected>Medium</option>
                                    <option value="High">High</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-4">
                                <label for="category" class="form-label fw-bold small text-uppercase">Category</label>
                                <div class="input-group">
                                    <select class="form-select border-0 bg-light" id="category" name="category">
                                        <option value="">No Category</option>
                                        <% if(categories) { %>
                                            <% categories.forEach(category => { %>
                                                <option value="<%= category._id %>"><%= category.name %></option>
                                            <% }) %>
                                        <% } %>
                                    </select>
                                    <a href="/categories" class="btn btn-light border-0 bg-light text-primary" title="Manage Categories">
                                        <i data-feather="plus-circle" style="width: 18px;"></i>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-4">
                                <label for="file" class="form-label fw-bold small text-uppercase">Attachment</label>
                                <input class="form-control border-0 bg-light" type="file" id="file" name="file">
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="mb-4">
                                <label for="description" class="form-label fw-bold small text-uppercase">Description</label>
                                <textarea class="form-control editor" id="description" name="description"></textarea>
                            </div>
                        </div>

                        <div class="col-12 text-end">
                            <hr class="my-4">
                            <button type="submit" class="btn btn-primary px-5 py-3 rounded-pill shadow">
                                <i data-feather="save"></i> Save Note
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
