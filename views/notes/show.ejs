<div class="row">
    <div class="col-lg-10 m-auto">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <a href="/notes" class="btn btn-light rounded-pill">
                <i data-feather="arrow-left"></i> Back
            </a>
            <div class="d-flex gap-2">
                <% if (canAccess(modules.TASKS)) { %>
                    <a href="/tasks/add?fromNote=<%= note._id %>" class="btn btn-outline-dark rounded-pill">
                        <i data-feather="clipboard"></i> <%= note.convertedTask ? 'Create Task Again' : 'Convert to Task' %>
                    </a>
                <% } %>
                <a href="/notes/edit/<%= note._id %>" class="btn btn-primary rounded-pill">
                    <i data-feather="edit-2"></i> Edit
                </a>
                <form action="/notes/trash/<%= note._id %>?_method=DELETE" method="POST">
                    <button type="submit" class="btn btn-outline-danger rounded-pill" onclick="confirmDelete(event)">
                        <i data-feather="trash-2"></i> Delete
                    </button>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm overflow-visible">
            <div class="card-header bg-transparent border-0 pt-4 px-4 px-md-5">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3"><%= note.category ? note.category.name : 'Uncategorized' %></span>
                    <% 
                        let pBadge = 'bg-success-subtle text-success';
                        if(note.priority === 'High') pBadge = 'bg-danger-subtle text-danger';
                        if(note.priority === 'Medium') pBadge = 'bg-warning-subtle text-warning';
                    %>
                    <span class="badge rounded-pill <%= pBadge %> px-3"><%= note.priority %> Priority</span>
                </div>
                <h1 class="fw-bold text-main mb-2"><%= note.title %></h1>
                <p class="text-muted small mb-0">
                    <i data-feather="calendar" style="width: 14px; height: 14px;" class="me-1"></i>
                    Created on <%= new Date(note.createdAt).toLocaleDateString(undefined, { dateStyle: 'long' }) %>
                </p>
            </div>
            <hr class="mx-4 mx-md-5">
            <div class="card-body p-4 p-md-5">
                <div class="note-content mb-5" style="line-height: 1.8; color: var(--text-main); font-size: 1.1rem;">
                    <%- note.description %>
                </div>

                <% if (note.convertedTask) { %>
                    <div class="alert alert-success border-0 rounded-4 mb-4">
                        This note is already linked to a task in your workflow board.
                    </div>
                <% } %>

                <% if(note.file) { %>
                    <div class="attachment-box bg-light p-4 rounded-4 border">
                        <h6 class="fw-bold text-uppercase small text-muted mb-3">Attached File</h6>
                        <% if(note.file.match(/\.(jpeg|jpg|png|gif|webp)$/i)) { %>
                            <img src="/uploads/<%= note.file %>" class="img-fluid rounded-3 shadow-sm mb-3" style="max-height: 500px;" alt="Attachment">
                        <% } %>
                        <div class="d-flex align-items-center">
                            <div class="bg-white p-2 rounded me-3 border">
                                <i data-feather="file" class="text-primary"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-bold small text-truncate" style="max-width: 250px;"><%= note.file %></div>
                                <div class="text-muted small">Ready to download</div>
                            </div>
                            <a href="/uploads/<%= note.file %>" target="_blank" class="btn btn-dark btn-sm rounded-pill px-3">
                                <i data-feather="download" style="width: 14px;"></i> Download
                            </a>
                        </div>
                    </div>
                <% } %>
            </div>
            <div class="card-footer bg-light border-0 py-3 px-4 px-md-5 text-muted small">
                Last updated: <%= new Date(note.updatedAt).toLocaleString() %>
            </div>
        </div>
    </div>
</div>
