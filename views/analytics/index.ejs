<div class="page-head">
    <div class="page-head-text">
        <h1>Analytics Dashboard</h1>
        <p>Measure throughput, productivity mix, and team activity.</p>
    </div>
    <div class="page-head-actions">
        <span class="mini-badge badge-soft-indigo">Live from workspace data</span>
    </div>
</div>

<div class="kpi-grid">
    <div class="kpi-card">
        <span class="kpi-icon kpi-indigo"><i data-feather="users"></i></span>
        <div class="kpi-meta">
            <span class="kpi-value"><%= summary.totalUsers %></span>
            <span class="kpi-label">Users</span>
        </div>
    </div>
    <div class="kpi-card">
        <span class="kpi-icon kpi-amber"><i data-feather="clipboard"></i></span>
        <div class="kpi-meta">
            <span class="kpi-value"><%= summary.totalTasks %></span>
            <span class="kpi-label">Tasks</span>
        </div>
    </div>
    <div class="kpi-card">
        <span class="kpi-icon kpi-emerald"><i data-feather="check-circle"></i></span>
        <div class="kpi-meta">
            <span class="kpi-value"><%= summary.completedTasks %></span>
            <span class="kpi-label">Completed</span>
        </div>
    </div>
    <div class="kpi-card">
        <span class="kpi-icon kpi-rose"><i data-feather="message-square"></i></span>
        <div class="kpi-meta">
            <span class="kpi-value"><%= summary.chatMessages %></span>
            <span class="kpi-label">Chat Activity</span>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header border-0 bg-transparent">
                <h5 class="fw-bold mb-0">Tasks Completed</h5>
            </div>
            <div class="card-body">
                <canvas data-chart="line" data-chart-labels='<%- JSON.stringify(completedTasks.map(item => item._id)) %>' data-chart-values='<%- JSON.stringify(completedTasks.map(item => item.total)) %>'></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header border-0 bg-transparent">
                <h5 class="fw-bold mb-0">Productivity by Priority</h5>
            </div>
            <div class="card-body">
                <canvas data-chart="doughnut" data-chart-labels='<%- JSON.stringify(productivity.map(item => item._id || "Unspecified")) %>' data-chart-values='<%- JSON.stringify(productivity.map(item => item.total)) %>'></canvas>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header border-0 bg-transparent">
                <h5 class="fw-bold mb-0">User Activity</h5>
            </div>
            <div class="card-body">
                <canvas data-chart="bar" data-chart-labels='<%- JSON.stringify(userActivity.map(item => item.name)) %>' data-chart-values='<%- JSON.stringify(userActivity.map(item => item.total)) %>' data-chart-secondary-values='<%- JSON.stringify(userActivity.map(item => item.completed)) %>'></canvas>
            </div>
        </div>
    </div>
</div>
