<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">Daily Work Log</h2>
    <div class="d-flex gap-2">
        <button id="sync-settings-btn" class="btn btn-outline-secondary rounded-pill shadow-sm" title="Google Sheets Settings">
            <i data-feather="settings"></i>
        </button>
        <button id="sync-google-sheets" class="btn btn-outline-success rounded-pill shadow-sm" title="Sync New Entries to Sheets">
            <i data-feather="refresh-cw"></i> <span class="d-none d-md-inline">Sync</span>
        </button>
        <button id="import-google-sheets" class="btn btn-outline-primary rounded-pill shadow-sm" title="Import from Sheets to DB">
            <i data-feather="download-cloud"></i> <span class="d-none d-md-inline">Import</span>
        </button>
        <button type="button" class="btn btn-outline-dark rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#dailyNotesExportModal" title="Export filtered logs">
            <i data-feather="file-down"></i> <span class="d-none d-md-inline">Export</span>
        </button>
        <a href="/daily-notes/add" class="btn btn-primary rounded-pill shadow-sm">
            <i data-feather="plus"></i> <span class="d-none d-md-inline">New Entry</span>
        </a>
    </div>
</div>

<%- include('../partials/export-modal', {
    modalId: 'dailyNotesExportModal',
    title: 'Daily Notes',
    resource: 'daily-notes',
    statuses: ['Pending', 'Started', 'InProgress', 'Completed', 'Holiday'],
    showProjectField: true,
    projectFieldLabel: 'Project Name',
    projectFieldPlaceholder: 'Filter by project name',
    values: {
        startDate: startDate,
        endDate: endDate,
        status: selectedStatus,
        projectName: search
    }
}) %>

<!-- Sync Settings Modal -->
<div class="modal fade" id="syncSettingsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Google Sheets Settings</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="sync-settings-form">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">Spreadsheet ID</label>
                        <input type="text" name="googleSpreadsheetId" class="form-control bg-light border-0 rounded-pill" placeholder="Enter ID from Spreadsheet URL" value="<%= user.googleSpreadsheetId || '' %>" required>
                        <div class="form-text small mt-2">
                            Found in URL: /d/<strong>SPREADSHEET_ID</strong>/edit
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">Sheet Name</label>
                        <input type="text" name="googleSheetName" class="form-control bg-light border-0 rounded-pill" placeholder="e.g. Sheet1" value="<%= user.googleSheetName || 'Sheet1' %>">
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 shadow-sm mt-2 mb-3">Save Settings</button>
                    
                    <hr class="text-muted opacity-25">
                    <div class="text-center">
                        <p class="small text-muted mb-2">Maintenance</p>
                        <button type="button" id="backfill-uids-btn" class="btn btn-light btn-sm rounded-pill px-3 border">
                            <i data-feather="tool" style="width: 14px;"></i> Backfill UIDs to Sheet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form action="/daily-notes" method="GET" class="row g-3 align-items-end">
            <div class="col-lg-3">
                <label class="form-label small fw-bold text-uppercase text-muted">Search</label>
                <div class="input-group bg-light rounded-pill px-2" style="border: 1px solid var(--border-color);">
                    <span class="input-group-text bg-transparent border-0"><i data-feather="search" style="width: 14px;"></i></span>
                    <input type="text" name="search" class="form-control bg-transparent border-0 shadow-none" placeholder="Project or Task..." value="<%= search %>">
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-uppercase text-muted">Period</label>
                <select name="filter" class="form-select border-0 bg-light rounded-pill" onchange="this.form.submit()">
                    <option value="today" <%= filter === 'today' ? 'selected' : '' %>>Today</option>
                    <option value="week" <%= filter === 'week' ? 'selected' : '' %>>This Week</option>
                    <option value="month" <%= filter === 'month' ? 'selected' : '' %>>This Month</option>
                    <option value="all" <%= filter === 'all' ? 'selected' : '' %>>All Time</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-uppercase text-muted">Status</label>
                <select name="status" class="form-select border-0 bg-light rounded-pill" onchange="this.form.submit()">
                    <option value="">All Status</option>
                    <option value="Pending" <%= selectedStatus === 'Pending' ? 'selected' : '' %>>Pending</option>
                    <option value="Started" <%= selectedStatus === 'Started' ? 'selected' : '' %>>Started</option>
                    <option value="InProgress" <%= selectedStatus === 'InProgress' ? 'selected' : '' %>>InProgress</option>
                    <option value="Completed" <%= selectedStatus === 'Completed' ? 'selected' : '' %>>Completed</option>
                    <option value="Holiday" <%= selectedStatus === 'Holiday' ? 'selected' : '' %>>Holiday</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-bold text-uppercase text-muted">Custom Range</label>
                <div class="input-group gap-2">
                    <input type="date" name="startDate" class="form-control border-0 bg-light rounded-pill" value="<%= startDate %>">
                    <input type="date" name="endDate" class="form-control border-0 bg-light rounded-pill" value="<%= endDate %>">
                </div>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-dark w-100 rounded-pill">Go</button>
            </div>
        </form>
    </div>
</div>

<!-- Logs Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4 py-3 text-muted small fw-bold text-uppercase">Date</th>
                    <th class="py-3 text-muted small fw-bold text-uppercase">Project</th>
                    <th class="py-3 text-muted small fw-bold text-uppercase">Task Title</th>
                    <th class="py-3 text-muted small fw-bold text-uppercase">Status</th>
                    <th class="pe-4 py-3 text-end text-muted small fw-bold text-uppercase">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if(dailyNotes.length > 0) { %>
                    <% dailyNotes.forEach(note => { %>
                        <tr>
                            <td class="ps-4">
                                <div class="fw-medium"><%= new Date(note.date).toLocaleDateString(undefined, { day: 'numeric', month: 'short' }) %></div>
                                <div class="text-muted small"><%= new Date(note.date).getFullYear() %></div>
                            </td>
                            <td><span class="text-primary fw-bold"><%= note.project_name %></span></td>
                            <td><%= note.task_title %></td>
                            <td>
                                <% 
                                    let bClass = 'bg-secondary-subtle text-secondary';
                                    if(note.status === 'Started') bClass = 'bg-primary-subtle text-primary';
                                    if(note.status === 'InProgress') bClass = 'bg-warning-subtle text-warning';
                                    if(note.status === 'Completed') bClass = 'bg-success-subtle text-success';
                                    if(note.status === 'Holiday') bClass = 'bg-danger-subtle text-danger';
                                %>
                                <span class="badge rounded-pill <%= bClass %>" style="font-size: 0.75rem;"><%= note.status %></span>
                            </td>
                            <td class="pe-4 text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a href="/daily-notes/<%= note._id %>" class="btn btn-light btn-sm rounded-pill p-2" title="View"><i data-feather="eye" style="width: 14px; height: 14px;"></i></a>
                                    <a href="/daily-notes/edit/<%= note._id %>" class="btn btn-light btn-sm rounded-pill p-2" title="Edit"><i data-feather="edit-2" style="width: 14px; height: 14px;"></i></a>
                                    <form action="/daily-notes/<%= note._id %>?_method=DELETE" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-light btn-sm rounded-pill p-2 text-danger" title="Delete" onclick="confirmDelete(event)"><i data-feather="trash-2" style="width: 14px; height: 14px;"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i data-feather="inbox" class="d-block mx-auto mb-3" style="width: 48px; height: 48px; opacity: 0.3;"></i>
                            No work logs found for this period.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination -->
<% if (totalPages > 1) { %>
<nav class="mt-4">
  <ul class="pagination justify-content-center border-0">
    <li class="page-item <%= page === 1 ? 'disabled' : '' %>">
      <a class="page-link border-0 rounded-pill mx-1 bg-light text-muted" href="?page=<%= page - 1 %>&filter=<%= filter %>&search=<%= search %>&status=<%= selectedStatus %>&startDate=<%= startDate %>&endDate=<%= endDate %>">Previous</a>
    </li>
    <% for(let i = 1; i <= totalPages; i++) { %>
      <li class="page-item <%= page === i ? 'active' : '' %>">
        <a class="page-link border-0 rounded-pill mx-1 <%= page === i ? 'bg-primary text-white shadow' : 'bg-light text-muted' %>" href="?page=<%= i %>&filter=<%= filter %>&search=<%= search %>&status=<%= selectedStatus %>&startDate=<%= startDate %>&endDate=<%= endDate %>"><%= i %></a>
      </li>
    <% } %>
    <li class="page-item <%= page === totalPages ? 'disabled' : '' %>">
      <a class="page-link border-0 rounded-pill mx-1 bg-light text-muted" href="?page=<%= page + 1 %>&filter=<%= filter %>&search=<%= search %>&status=<%= selectedStatus %>&startDate=<%= startDate %>&endDate=<%= endDate %>">Next</a>
    </li>
  </ul>
</nav>
<% } %>
