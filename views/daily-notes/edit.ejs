<div class="row">
    <div class="col-lg-10 m-auto">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <h2 class="fw-bold mb-0">Edit Daily Work Log</h2>
            <div class="d-flex gap-2">
                <a href="/daily-notes/<%= note._id %>" class="btn btn-light rounded-pill">
                    <i data-feather="eye"></i> View
                </a>
                <a href="/daily-notes" class="btn btn-light rounded-pill">
                    <i data-feather="arrow-left"></i> Back
                </a>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <form id="daily-note-form" action="/daily-notes/<%= note._id %>?_method=PUT" method="POST" novalidate>
                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="date" class="form-label small fw-bold text-uppercase">Date</label>
                                <input type="date" class="form-control border-0 bg-light" id="date" name="date" 
                                    value="<%= new Date(note.date).toISOString().split('T')[0] %>" required>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="project_name" class="form-label small fw-bold text-uppercase">Project Name</label>
                                <input type="text" class="form-control border-0 bg-light" id="project_name" name="project_name" 
                                    value="<%= note.project_name %>" required>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="status" class="form-label small fw-bold text-uppercase">Status</label>
                                <select class="form-select border-0 bg-light" id="status" name="status" required>
                                    <option value="Pending" <%= note.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                                    <option value="Started" <%= note.status === 'Started' ? 'selected' : '' %>>Started</option>
                                    <option value="InProgress" <%= note.status === 'InProgress' ? 'selected' : '' %>>In Progress</option>
                                    <option value="Completed" <%= note.status === 'Completed' ? 'selected' : '' %>>Completed</option>
                                    <option value="Holiday" <%= note.status === 'Holiday' ? 'selected' : '' %>>Holiday</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="mb-3">
                                <label for="task_title" class="form-label small fw-bold text-uppercase">Task Title</label>
                                <input type="text" class="form-control border-0 bg-light" id="task_title" name="task_title" 
                                    value="<%= note.task_title %>" required>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="day_start_description" class="form-label small fw-bold text-uppercase text-primary">Day Start / Planned</label>
                                <textarea class="form-control editor" id="day_start_description" name="day_start_description"><%= note.day_start_description %></textarea>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="day_end_description" class="form-label small fw-bold text-uppercase text-success">Day End / Achievements</label>
                                <textarea class="form-control editor" id="day_end_description" name="day_end_description"><%= note.day_end_description %></textarea>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="mb-3">
                                <label for="remarks" class="form-label small fw-bold text-uppercase">Remarks</label>
                                <textarea class="form-control border-0 bg-light" id="remarks" name="remarks" rows="2"><%= note.remarks %></textarea>
                            </div>
                        </div>

                        <div class="col-12 text-end mt-4">
                            <hr class="mb-4">
                            <button type="submit" class="btn btn-primary px-5 py-3 rounded-pill shadow">
                                <i data-feather="check"></i> Update Work Log
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
