<div class="page-head">
    <div class="page-head-text">
        <h1>Reset link ready</h1>
        <p>SMTP is not configured, so the link is shown here instead of being emailed.</p>
    </div>
    <a href="/admin/users" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
        <i class="fa-solid fa-arrow-left"></i> Back to users
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <div class="d-flex align-items-start gap-3 mb-4">
            <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2">
                <i class="fa-solid fa-flask"></i> Dev mode
            </span>
            <div>
                <h5 class="mb-1 fw-bold">Password reset link for <%= targetUser.name %></h5>
                <p class="text-muted mb-0">
                    <<%= targetUser.email %>> — valid for <%= ttl %> minutes, usable once.
                    Share it with the user through a trusted channel.
                </p>
            </div>
        </div>

        <label class="form-label fw-semibold" for="reset-url">Reset link</label>
        <div class="input-group">
            <input type="text" id="reset-url" class="form-control bg-light font-monospace small" value="<%= resetUrl %>" readonly>
            <button class="btn btn-primary" type="button" id="copy-reset-url">
                <i class="fa-solid fa-copy"></i> Copy
            </button>
        </div>

        <div class="alert alert-warning mt-4 mb-0 small" role="alert">
            <i class="fa-solid fa-triangle-exclamation"></i>
            The user's account was signed out of all devices. For real emails, fill
            <code>SMTP_HOST</code>, <code>SMTP_USER</code> and <code>SMTP_PASS</code> in <code>.env</code>.
        </div>
    </div>
</div>

<script>
(function () {
    var btn = document.getElementById('copy-reset-url');
    if (!btn) return;
    btn.addEventListener('click', function () {
        var input = document.getElementById('reset-url');
        input.select();
        navigator.clipboard.writeText(input.value).then(function () {
            if (window.Swal) {
                Swal.fire({
                    toast: true, position: 'top-end', icon: 'success',
                    title: 'Link copied', showConfirmButton: false, timer: 1800
                });
            }
        }).catch(function () {
            document.execCommand('copy');
        });
    });
})();
</script>
