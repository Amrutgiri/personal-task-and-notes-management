<div class="page-head">
    <div class="page-head-text">
        <h1>User Roles</h1>
        <p>Manage workspace roles and module-level access across the team.</p>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="px-4 py-2">Name</th>
                        <th class="py-2">Email</th>
                        <th class="py-2">Role</th>
                        <th class="py-2">Joined</th>
                        <th class="text-end px-4 py-2">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(member => { %>
                        <tr>
                            <td class="px-4 py-2 fw-semibold"><%= member.name %></td>
                            <td class="py-2 text-muted"><%= member.email %></td>
                            <td class="py-2">
                                <span class="badge bg-primary-subtle text-primary"><%= member.role %></span>
                            </td>
                            <td class="py-2 text-muted"><%= new Date(member.createdAt).toLocaleDateString() %></td>
                            <td class="px-4 py-2">
                                <div class="d-flex justify-content-end align-items-center gap-2">
                                    <form action="/admin/users/<%= member._id %>/role?_method=PUT" method="POST" class="d-flex gap-2">
                                        <select class="form-select form-select-sm bg-light border-0" name="role" style="max-width: 160px;">
                                            <option value="admin" <%= member.role === 'admin' ? 'selected' : '' %>>Admin</option>
                                            <option value="manager" <%= member.role === 'manager' ? 'selected' : '' %>>Manager</option>
                                            <option value="employee" <%= member.role === 'employee' ? 'selected' : '' %>>Employee</option>
                                        </select>
                                        <button class="btn btn-sm btn-primary" type="submit">Update</button>
                                    </form>
                                    <% if (String(member._id) !== String(user._id)) { %>
                                    <form class="admin-reset-form" action="/admin/users/<%= member._id %>/reset-link" method="POST" data-user-name="<%= member.name %>">
                                        <button class="btn btn-sm btn-outline-danger" type="submit" title="Email a password reset link to this user">
                                            <i class="fa-solid fa-key"></i> Reset
                                        </button>
                                    </form>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
(function () {
    document.querySelectorAll('.admin-reset-form').forEach(function (form) {
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            var userName = form.getAttribute('data-user-name') || 'this user';
            Swal.fire({
                title: 'Send reset link?',
                html: 'A one-time password reset link will be emailed to <strong>' + userName +
                    '</strong>.<br>Their current sessions will be signed out.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#4f46e5',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, send it'
            }).then(function (result) {
                if (result.isConfirmed) form.submit();
            });
        });
    });
})();
</script>
