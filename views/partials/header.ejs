<header class="top-navbar">
    <div class="d-flex align-items-center">
        <button class="btn btn-light me-3 d-md-none sidebar-toggle">
            <i data-feather="menu"></i>
        </button>
        <button class="btn btn-light me-3 d-none d-md-flex sidebar-toggle">
            <i data-feather="sidebar"></i>
        </button>
        <% if (canAccess(modules.SEARCH)) { %>
            <form action="/search" method="GET" class="search-bar d-none d-lg-flex align-items-center bg-light px-3 rounded-pill" style="width: 340px; height: 40px; border: 1px solid var(--border-color);">
                <i data-feather="search" class="text-muted" style="width: 16px;"></i>
                <input type="text" name="q" class="form-control bg-transparent border-0 shadow-none" placeholder="Search notes, tasks, chat..." style="font-size: 0.9rem;">
            </form>
        <% } %>
    </div>

    <div class="d-flex align-items-center gap-3">
        <div class="dropdown">
            <a href="#" class="btn btn-light rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;" data-bs-toggle="dropdown">
                <i data-feather="bell"></i>
            </a>
            <div class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" style="width: 280px; border-radius: 12px;">
                <h6 class="dropdown-header">Notifications</h6>
                <div class="p-3 text-center text-muted small">No new notifications</div>
            </div>
        </div>

        <div class="dropdown">
            <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle" data-bs-toggle="dropdown">
                <img src="<%= user.profileImage || '/img/default-avatar.png' %>" class="rounded-circle object-fit-cover" style="width: 40px; height: 40px;" alt="<%= user.name %>">
                <div class="ms-2 d-none d-md-block">
                    <div class="fw-bold small text-main"><%= user.name %></div>
                    <div class="text-muted text-capitalize" style="font-size: 0.7rem;"><%= user.role %> · <%= user.email %></div>
                </div>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" style="border-radius: 12px;">
                <li><a class="dropdown-item py-2" href="/profile"><i data-feather="user" class="me-2" style="width: 16px;"></i> Profile</a></li>
                <li><a class="dropdown-item py-2" href="/profile/edit"><i data-feather="settings" class="me-2" style="width: 16px;"></i> Settings</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item py-2 text-danger" href="/auth/logout"><i data-feather="log-out" class="me-2" style="width: 16px;"></i> Logout</a></li>
            </ul>
        </div>
    </div>
</header>
