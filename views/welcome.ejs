<div class="row min-vh-100 align-items-center">
    <div class="col-lg-6 mb-5 mb-lg-0 px-md-5">
        <div class="bg-primary text-white rounded-4 d-inline-flex align-items-center justify-content-center mb-4" style="width: 56px; height: 56px; box-shadow: 0 10px 20px -5px rgba(79, 70, 229, 0.5);">
            <i data-feather="zap" style="width: 28px; height: 28px;"></i>
        </div>
        <h1 class="display-3 fw-bold text-main mb-4">Organize your life with <span class="text-primary">ZenNotes</span></h1>
        <p class="lead text-muted mb-5">The minimal, high-performance notes application designed for modern thinkers. Manage notes, track daily work, and stay productive.</p>
        
        <div class="d-flex flex-wrap gap-3">
            <a href="/auth/register" class="btn btn-primary btn-lg px-5 rounded-pill shadow">Get Started — It's Free</a>
            <a href="/auth/login" class="btn btn-outline-dark btn-lg px-5 rounded-pill">Login</a>
        </div>

        <div class="mt-5 d-flex align-items-center gap-4 text-muted small">
            <div class="d-flex align-items-center"><i data-feather="check" class="text-success me-2" style="width: 16px;"></i> Rich Text Support</div>
            <div class="d-flex align-items-center"><i data-feather="check" class="text-success me-2" style="width: 16px;"></i> Dark Mode</div>
            <div class="d-flex align-items-center"><i data-feather="check" class="text-success me-2" style="width: 16px;"></i> Work Logs</div>
        </div>
    </div>
    <div class="col-lg-6 d-none d-lg-block">
        <div class="position-relative">
            <!-- Decorative elements -->
            <div class="position-absolute top-0 start-0 translate-middle bg-primary rounded-circle opacity-10" style="width: 400px; height: 400px; z-index: -1;"></div>
            <div class="position-absolute bottom-0 end-0 translate-middle bg-info rounded-circle opacity-10" style="width: 300px; height: 300px; z-index: -1;"></div>
            
            <div class="card border-0 shadow-lg p-3" style="border-radius: 24px; transform: perspective(1000px) rotateY(-15deg) rotateX(5deg);">
                <div class="bg-light rounded-4 p-4" style="min-height: 400px;">
                    <div class="d-flex gap-2 mb-4">
                        <div class="rounded-circle bg-danger opacity-50" style="width: 12px; height: 12px;"></div>
                        <div class="rounded-circle bg-warning opacity-50" style="width: 12px; height: 12px;"></div>
                        <div class="rounded-circle bg-success opacity-50" style="width: 12px; height: 12px;"></div>
                    </div>
                    <div class="placeholder-glow">
                        <span class="placeholder col-7 mb-3 rounded"></span>
                        <span class="placeholder col-10 mb-2 rounded small"></span>
                        <span class="placeholder col-8 mb-4 rounded small"></span>
                        <div class="row g-3">
                            <div class="col-6"><div class="card border-0 shadow-sm p-3 rounded-4"><span class="placeholder col-12"></span></div></div>
                            <div class="col-6"><div class="card border-0 shadow-sm p-3 rounded-4"><span class="placeholder col-12"></span></div></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
