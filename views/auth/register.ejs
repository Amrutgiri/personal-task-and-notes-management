<div class="row min-vh-100 align-items-center justify-content-center g-0">
    <div class="col-md-5 col-lg-4">
        <div class="text-center mb-5">
            <div class="bg-primary text-white rounded-4 d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px; box-shadow: 0 10px 20px -5px rgba(79, 70, 229, 0.5);">
                <i data-feather="zap" style="width: 32px; height: 32px;"></i>
            </div>
            <h2 class="fw-bold">Create an account</h2>
            <p class="text-muted">Join ZenNotes and stay organized.</p>
        </div>

        <div class="card border-0 shadow-lg p-2" style="border-radius: 24px;">
            <div class="card-body p-4 p-md-5">
                <form id="register-form" action="/auth/register" method="POST" novalidate>
                    <div class="mb-4">
                        <label for="name" class="form-label small fw-bold text-uppercase text-muted">Full Name</label>
                        <input type="text" id="name" name="name" class="form-control form-control-lg border-0 bg-light" placeholder="John Doe" value="<%= typeof name != 'undefined' ? name : '' %>" required>
                    </div>
                    <div class="mb-4">
                        <label for="email" class="form-label small fw-bold text-uppercase text-muted">Email address</label>
                        <input type="email" id="email" name="email" class="form-control form-control-lg border-0 bg-light" placeholder="name@company.com" value="<%= typeof email != 'undefined' ? email : '' %>" required>
                    </div>
                    <div class="mb-4">
                        <label for="password" class="form-label small fw-bold text-uppercase text-muted">Password</label>
                        <input type="password" id="password" name="password" class="form-control form-control-lg border-0 bg-light" placeholder="At least 6 characters" required>
                    </div>
                    <div class="mb-4">
                        <label for="confirm_password" class="form-label small fw-bold text-uppercase text-muted">Confirm Password</label>
                        <input type="password" id="confirm_password" name="confirm_password" class="form-control form-control-lg border-0 bg-light" placeholder="••••••••" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm">
                        Create account
                    </button>
                </form>
            </div>
        </div>

        <p class="text-center mt-5 text-muted">
            Already have an account? <a href="/auth/login" class="text-primary fw-bold text-decoration-none">Sign in</a>
        </p>
    </div>
</div>
