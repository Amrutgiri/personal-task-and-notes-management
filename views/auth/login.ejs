<div class="row min-vh-100 align-items-center justify-content-center g-0">
    <div class="col-md-5 col-lg-4">
        <div class="text-center mb-5">
            <div class="bg-primary text-white rounded-4 d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px; box-shadow: 0 10px 20px -5px rgba(79, 70, 229, 0.5);">
                <i data-feather="zap" style="width: 32px; height: 32px;"></i>
            </div>
            <h2 class="fw-bold">Welcome back</h2>
            <p class="text-muted">Please enter your details to sign in.</p>
        </div>

        <div class="card border-0 shadow-lg p-2" style="border-radius: 24px;">
            <div class="card-body p-4 p-md-5">
                <form id="login-form" action="/auth/login" method="POST" novalidate>
                    <div class="mb-4">
                        <label for="email" class="form-label small fw-bold text-uppercase text-muted">Email address</label>
                        <input type="email" id="email" name="email" class="form-control form-control-lg border-0 bg-light" placeholder="name@company.com" required>
                    </div>
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label for="password" class="form-label small fw-bold text-uppercase text-muted mb-0">Password</label>
                            <a href="#" class="text-primary small text-decoration-none fw-medium">Forgot?</a>
                        </div>
                        <input type="password" id="password" name="password" class="form-control form-control-lg border-0 bg-light" placeholder="••••••••" required>
                    </div>
                    <div class="mb-4 form-check">
                        <input type="checkbox" class="form-check-input" id="remember">
                        <label class="form-check-label small text-muted" for="remember">Remember me for 30 days</label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm">
                        Sign in
                    </button>
                </form>
            </div>
        </div>

        <p class="text-center mt-5 text-muted">
            Don't have an account? <a href="/auth/register" class="text-primary fw-bold text-decoration-none">Sign up for free</a>
        </p>
    </div>
</div>
