<div class="auth-wrap">
    <%- include('../partials/auth-brand', {
        eyebrow: 'Welcome back',
        headline: 'Your workspace, always in sync.',
        sub: 'Sign in to pick up where you left off — your notes, tasks and daily logs are waiting for you.'
    }) %>

    <section class="auth-panel">
        <div class="auth-panel-inner">
            <header class="auth-panel-head">
                <a href="/" class="auth-mobile-logo">
                    <span class="auth-logo-mark auth-logo-mark-dark"><i data-feather="zap"></i></span>
                    <span>ZenNotes</span>
                </a>
                <h2>Sign in</h2>
                <p>Welcome back! Please enter your details to continue.</p>
            </header>

            <div class="auth-card">
                <% const loginAlerts = [...(error_msg || []), ...(error || [])]; %>
                <% if (loginAlerts.length) { %>
                <div class="auth-alert auth-alert-error" role="alert">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span><%= loginAlerts[0] %></span>
                </div>
                <% } %>
                <% if (success_msg && success_msg.length) { %>
                <div class="auth-alert auth-alert-success" role="alert">
                    <i class="fa-solid fa-circle-check"></i>
                    <span><%= success_msg[0] %></span>
                </div>
                <% } %>

                <form id="login-form" action="/auth/login" method="POST" novalidate>
                    <div class="auth-field">
                        <label for="email">Email address</label>
                        <input type="email" id="email" name="email" class="form-control" placeholder="name@company.com" autocomplete="email" value="<%= old_email || '' %>" required>
                    </div>

                    <div class="auth-field">
                        <div class="auth-label-row">
                            <label for="password">Password</label>
                            <a href="/auth/forgot-password" class="auth-link">Forgot password?</a>
                        </div>
                        <div class="password-field">
                            <input type="password" id="password" name="password" class="form-control" placeholder="Enter your password" autocomplete="current-password" required>
                            <button type="button" class="password-toggle" data-password-toggle="#password" aria-label="Show password" tabindex="-1">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="auth-check">
                        <input type="checkbox" class="form-check-input" id="remember" name="remember">
                        <label class="form-check-label" for="remember">Remember me for 30 days</label>
                    </div>

                    <button type="submit" class="btn btn-primary auth-submit">
                        Sign in <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </form>
            </div>

            <p class="auth-switch">
                Don’t have an account?
                <a href="/auth/register" class="auth-link-strong">Create an account</a>
            </p>
        </div>
    </section>
</div>
