<div class="auth-wrap">
    <%- include('../partials/auth-brand', {
        eyebrow: 'Secure reset',
        headline: 'Choose a new password for your account.',
        sub: 'Your new password is encrypted with bcrypt and every active session is signed out after the change.'
    }) %>

    <section class="auth-panel">
        <div class="auth-panel-inner">
            <header class="auth-panel-head">
                <a href="/" class="auth-mobile-logo">
                    <span class="auth-logo-mark auth-logo-mark-dark"><i data-feather="zap"></i></span>
                    <span>ZenNotes</span>
                </a>
                <h2>Set new password</h2>
                <p>Enter and confirm your new password below.</p>
            </header>

            <div class="auth-card">
                <%
                    const resetAlerts = [...(error_msg || []), ...(error || [])];
                    const resetSuccess = success_msg || [];
                    const isInvalid = typeof invalid != 'undefined' && invalid;
                %>
                <% if (isInvalid) { %>
                <div class="auth-alert auth-alert-error" role="alert">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span>This reset link is invalid or has expired. Please request a new one.</span>
                </div>
                <% } %>
                <% if (resetAlerts.length) { %>
                <div class="auth-alert auth-alert-error" role="alert">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span><%= resetAlerts[0] %></span>
                </div>
                <% } %>
                <% if (resetSuccess.length) { %>
                <div class="auth-alert auth-alert-success" role="alert">
                    <i class="fa-solid fa-circle-check"></i>
                    <span><%= resetSuccess[0] %></span>
                </div>
                <% } %>

                <% if (isInvalid || typeof token == 'undefined' || !token) { %>
                <div class="text-center py-2">
                    <a href="/auth/forgot-password" class="btn btn-primary auth-submit">
                        Request a new link <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
                <% } else { %>
                <form id="reset-password-form" action="/auth/reset-password" method="POST" novalidate>
                    <input type="hidden" name="token" value="<%= token %>">

                    <div class="auth-field">
                        <label for="password">New password</label>
                        <div class="password-field">
                            <input type="password" id="password" name="password" class="form-control" placeholder="At least 8 characters" autocomplete="new-password" required>
                            <button type="button" class="password-toggle" data-password-toggle="#password" aria-label="Show password" tabindex="-1">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="auth-field">
                        <label for="confirm_password">Confirm new password</label>
                        <div class="password-field">
                            <input type="password" id="confirm_password" name="confirm_password" class="form-control" placeholder="Re-enter your password" autocomplete="new-password" required>
                            <button type="button" class="password-toggle" data-password-toggle="#confirm_password" aria-label="Show password" tabindex="-1">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary auth-submit">
                        Update password <i class="fa-solid fa-key"></i>
                    </button>

                    <p class="auth-terms">
                        Use at least 8 characters with an uppercase letter, a lowercase letter and a number.
                    </p>
                </form>
                <% } %>
            </div>

            <p class="auth-switch">
                Remembered it?
                <a href="/auth/login" class="auth-link-strong">Back to sign in</a>
            </p>
        </div>
    </section>
</div>
