<div class="auth-wrap">
    <%- include('../partials/auth-brand', {
        eyebrow: 'Account recovery',
        headline: 'Reset your password in a few seconds.',
        sub: 'Enter the email linked to your account and we will send you a secure link to set a new password.'
    }) %>

    <section class="auth-panel">
        <div class="auth-panel-inner">
            <header class="auth-panel-head">
                <a href="/" class="auth-mobile-logo">
                    <span class="auth-logo-mark auth-logo-mark-dark"><i data-feather="zap"></i></span>
                    <span>ZenNotes</span>
                </a>
                <h2>Forgot password?</h2>
                <p>Enter your email and we’ll send you a reset link.</p>
            </header>

            <div class="auth-card">
                <%
                    const forgotAlerts = [...(error_msg || []), ...(error || [])];
                    const forgotSuccess = success_msg || [];
                %>
                <% if (forgotAlerts.length) { %>
                <div class="auth-alert auth-alert-error" role="alert">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span><%= forgotAlerts[0] %></span>
                </div>
                <% } %>
                <% if (forgotSuccess.length) { %>
                <div class="auth-alert auth-alert-success" role="alert">
                    <i class="fa-solid fa-circle-check"></i>
                    <span><%= forgotSuccess[0] %></span>
                </div>
                <% } %>

                <% if (typeof devResetUrl != 'undefined' && devResetUrl) { %>
                <div class="auth-devbox" role="alert">
                    <div class="auth-devbox-title">
                        <i class="fa-solid fa-flask"></i>
                        Dev mode — SMTP not configured
                    </div>
                    <p>
                        No email was sent because <code>SMTP_HOST</code> / <code>SMTP_USER</code> /
                        <code>SMTP_PASS</code> are missing from <code>.env</code>.
                        Use this link for <strong><%= devEmail %></strong> (valid <%= ttl %> min):
                    </p>
                    <a href="<%= devResetUrl %>" class="auth-devbox-link"><%= devResetUrl %></a>
                </div>
                <% } %>

                <form id="forgot-password-form" action="/auth/forgot-password" method="POST" novalidate>
                    <div class="auth-field">
                        <label for="email">Email address</label>
                        <input type="email" id="email" name="email" class="form-control" placeholder="name@company.com" autocomplete="email" value="<%= old_email || '' %>" required>
                    </div>

                    <button type="submit" class="btn btn-primary auth-submit">
                        Send reset link <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </form>
            </div>

            <p class="auth-switch">
                Remembered it?
                <a href="/auth/login" class="auth-link-strong">Back to sign in</a>
            </p>
        </div>
    </section>
</div>
