<div class="page-head">
    <div class="page-head-text">
        <h1>Welcome back, <%= user.name %></h1>
        <p>Here’s what’s happening across your notes, tasks, and team workflow today.</p>
    </div>
    <div class="page-head-actions">
        <a href="/tasks/board" class="btn btn-outline-primary btn-sm">
            <i data-feather="columns" class="btn-ico"></i> Open Board
        </a>
        <a href="/tasks/add" class="btn btn-primary btn-sm">
            <i data-feather="plus" class="btn-ico"></i> New Task
        </a>
    </div>
</div>

<div class="kpi-grid">
    <div class="kpi-card">
        <span class="kpi-icon kpi-indigo"><i data-feather="file-text"></i></span>
        <div class="kpi-meta">
            <span class="kpi-value"><%= stats.totalNotes %></span>
            <span class="kpi-label">Total Notes</span>
        </div>
    </div>
    <div class="kpi-card">
        <span class="kpi-icon kpi-emerald"><i data-feather="check-circle"></i></span>
        <div class="kpi-meta">
            <span class="kpi-value"><%= stats.doneTasks %></span>
            <span class="kpi-label">Tasks Done</span>
        </div>
    </div>
    <div class="kpi-card">
        <span class="kpi-icon kpi-amber"><i data-feather="clock"></i></span>
        <div class="kpi-meta">
            <span class="kpi-value"><%= stats.totalTasks - stats.doneTasks %></span>
            <span class="kpi-label">Open Tasks</span>
        </div>
    </div>
    <div class="kpi-card">
        <span class="kpi-icon kpi-rose"><i data-feather="alert-triangle"></i></span>
        <div class="kpi-meta">
            <span class="kpi-value"><%= stats.overdueTasks %></span>
            <span class="kpi-label">Overdue Tasks</span>
        </div>
    </div>
</div>

<div class="dash-grid">
    <section class="dash-card">
        <header class="dash-card-head">
            <div>
                <h2>Recent Tasks</h2>
                <span class="dash-card-sub">Latest activity across your tasks</span>
            </div>
            <a href="/tasks/board" class="btn btn-outline-primary btn-xs">Open Board</a>
        </header>
        <div class="dash-card-body">
            <% if(recentTasks && recentTasks.length > 0) { %>
                <div class="mini-list">
                    <% recentTasks.forEach(task => { %>
                        <a href="/tasks/edit/<%= task._id %>" class="mini-row">
                            <%
                                let dotClass = 'dot-secondary';
                                let badgeClass = 'badge-soft badge-soft-gray';
                                if(task.status === 'Todo') { dotClass = 'dot-indigo'; badgeClass = 'badge-soft badge-soft-indigo'; }
                                if(task.status === 'In Progress') { dotClass = 'dot-amber'; badgeClass = 'badge-soft badge-soft-amber'; }
                                if(task.status === 'Done') { dotClass = 'dot-emerald'; badgeClass = 'badge-soft badge-soft-emerald'; }
                            %>
                            <span class="mini-dot <%= dotClass %>"></span>
                            <span class="mini-body">
                                <span class="mini-title"><%= task.title %></span>
                                <span class="mini-sub">
                                    <i data-feather="calendar" class="mini-ico"></i>
                                    <%= task.deadline ? new Date(task.deadline).toLocaleDateString() : 'No deadline' %>
                                    <span class="mini-sep">·</span>
                                    Assigned to <%= task.assignedTo ? task.assignedTo.name : 'Unassigned' %>
                                </span>
                            </span>
                            <span class="mini-badge <%= badgeClass %>"><%= task.status %></span>
                        </a>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="dash-empty">
                    <span class="dash-empty-icon"><i data-feather="clipboard"></i></span>
                    <p>No tasks created yet.</p>
                    <a href="/tasks/add" class="btn btn-primary btn-xs">Create Task</a>
                </div>
            <% } %>
        </div>
    </section>

    <section class="dash-card">
        <header class="dash-card-head">
            <div>
                <h2>Recent Notes</h2>
                <span class="dash-card-sub">Last updated notes</span>
            </div>
            <a href="/notes" class="btn btn-outline-primary btn-xs">View All</a>
        </header>
        <div class="dash-card-body">
            <% if(recentNotes.length > 0) { %>
                <div class="mini-list">
                    <% recentNotes.forEach(note => { %>
                        <a href="/notes/<%= note._id %>" class="mini-row">
                            <%
                                let pBadge = 'badge-soft badge-soft-emerald';
                                if(note.priority === 'High') pBadge = 'badge-soft badge-soft-rose';
                                if(note.priority === 'Medium') pBadge = 'badge-soft badge-soft-amber';
                            %>
                            <span class="mini-body">
                                <span class="mini-title"><%= note.title %></span>
                                <span class="mini-sub">
                                    <i data-feather="clock" class="mini-ico"></i>
                                    <%= new Date(note.updatedAt).toLocaleDateString() %>
                                </span>
                            </span>
                            <span class="mini-badge <%= pBadge %>"><%= note.priority %></span>
                            <i data-feather="chevron-right" class="mini-arrow"></i>
                        </a>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="dash-empty">
                    <span class="dash-empty-icon"><i data-feather="file-text"></i></span>
                    <p>No recent notes.</p>
                </div>
            <% } %>
        </div>
    </section>
</div>

<div class="dash-grid dash-grid-3">
    <section class="dash-card">
        <header class="dash-card-head">
            <div>
                <h2>Workflow Snapshot</h2>
                <span class="dash-card-sub">Tasks grouped by status</span>
            </div>
        </header>
        <div class="dash-card-body">
            <canvas data-chart="bar" data-chart-labels='<%- JSON.stringify(chartTasksByStatus.map(item => item._id)) %>' data-chart-values='<%- JSON.stringify(chartTasksByStatus.map(item => item.total)) %>'></canvas>
        </div>
    </section>

    <section class="dash-card">
        <header class="dash-card-head">
            <div>
                <h2>Priority Mix</h2>
                <span class="dash-card-sub">Distribution by priority</span>
            </div>
        </header>
        <div class="dash-card-body">
            <canvas data-chart="doughnut" data-chart-labels='<%- JSON.stringify(productivityByPriority.map(item => item._id || "Unspecified")) %>' data-chart-values='<%- JSON.stringify(productivityByPriority.map(item => item.total)) %>'></canvas>
        </div>
    </section>

    <section class="dash-card">
        <header class="dash-card-head">
            <div>
                <h2>Work Log Snapshot</h2>
                <span class="dash-card-sub">Latest daily work logs</span>
            </div>
        </header>
        <div class="dash-card-body">
            <% if(recentWorkLogs && recentWorkLogs.length > 0) { %>
                <div class="mini-list">
                    <% recentWorkLogs.forEach(log => { %>
                        <a href="/daily-notes/<%= log._id %>" class="mini-row">
                            <span class="mini-dot dot-sky"></span>
                            <span class="mini-body">
                                <span class="mini-title"><%= log.project_name %></span>
                                <span class="mini-sub">
                                    <i data-feather="calendar" class="mini-ico"></i>
                                    <%= new Date(log.date).toLocaleDateString() %>
                                    <span class="mini-sep">·</span>
                                    <%= log.task_title %>
                                </span>
                            </span>
                            <i data-feather="chevron-right" class="mini-arrow"></i>
                        </a>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="dash-empty">
                    <span class="dash-empty-icon"><i data-feather="calendar"></i></span>
                    <p>No daily work logs available.</p>
                </div>
            <% } %>
        </div>
    </section>
</div>

<a href="/tasks/add" class="fab" title="New task">
    <i data-feather="plus"></i>
</a>
