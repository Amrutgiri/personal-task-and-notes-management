<div class="row">
    <div class="col-xl-10 mx-auto">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">Edit Task</h2>
                <p class="text-muted mb-0">Update progress, assignment, and delivery details.</p>
            </div>
            <a href="/tasks" class="btn btn-light rounded-pill">
                <i data-feather="arrow-left"></i> Back
            </a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <form id="task-form" action="/tasks/<%= task._id %>?_method=PUT" method="POST" novalidate>
                    <div class="row g-4">
                        <div class="col-md-8">
                            <label class="form-label fw-bold small text-uppercase">Task Title</label>
                            <input class="form-control form-control-lg bg-light border-0" type="text" name="title" value="<%= task.title %>" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-uppercase">Priority</label>
                            <select class="form-select bg-light border-0" name="priority">
                                <% taskPriorities.forEach(priority => { %>
                                    <option value="<%= priority %>" <%= task.priority === priority ? 'selected' : '' %>><%= priority %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-uppercase">Assigned User</label>
                            <select class="form-select bg-light border-0" name="assignedTo">
                                <option value="">Unassigned</option>
                                <% users.forEach(member => { %>
                                    <option value="<%= member._id %>" <%= task.assignedTo && String(task.assignedTo._id) === String(member._id) ? 'selected' : '' %>><%= member.name %> · <%= member.role %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold small text-uppercase">Deadline</label>
                            <input class="form-control bg-light border-0" type="date" name="deadline" value="<%= task.deadline ? new Date(task.deadline).toISOString().split('T')[0] : '' %>">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold small text-uppercase">Status</label>
                            <select class="form-select bg-light border-0" name="status">
                                <% taskStatuses.forEach(status => { %>
                                    <option value="<%= status %>" <%= task.status === status ? 'selected' : '' %>><%= status %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-uppercase">Description</label>
                            <textarea class="form-control editor" id="description" name="description"><%= task.description %></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-uppercase">Tags</label>
                            <input class="form-control bg-light border-0" type="text" name="tags" value="<%= (task.tags || []).join(', ') %>">
                        </div>
                        <div class="col-12">
                            <div class="bg-light rounded-4 p-3 d-flex flex-wrap gap-4">
                                <div><small class="text-muted d-block">Created By</small><strong><%= task.createdBy ? task.createdBy.name : 'Unknown' %></strong></div>
                                <div><small class="text-muted d-block">Source Note</small><strong><%= task.sourceNote ? task.sourceNote.title : 'Direct task' %></strong></div>
                                <div><small class="text-muted d-block">Activity Count</small><strong><%= task.activityCount || 0 %></strong></div>
                            </div>
                        </div>
                        <div class="col-12 text-end">
                            <button type="submit" class="btn btn-primary px-5">
                                <i data-feather="check"></i> Update Task
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
