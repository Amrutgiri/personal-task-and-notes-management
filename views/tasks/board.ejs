<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Kanban Board</h2>
        <p class="text-muted mb-0">Drag cards between columns to update the real task status instantly.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/tasks" class="btn btn-light">
            <i data-feather="list"></i> Task List
        </a>
        <a href="/tasks/add" class="btn btn-primary">
            <i data-feather="plus"></i> Add Task
        </a>
    </div>
</div>

<div class="kanban-board" data-kanban-board>
    <% taskStatuses.forEach(status => { %>
        <section class="kanban-column" data-status="<%= status %>">
            <div class="kanban-column-header">
                <div>
                    <h5 class="fw-bold mb-1"><%= status %></h5>
                    <small class="text-muted"><%= (groupedTasks[status] || []).length %> items</small>
                </div>
                <span class="badge bg-light text-dark border"><%= status === 'Done' ? 'Delivery' : 'Pipeline' %></span>
            </div>
            <div class="kanban-dropzone">
                <% (groupedTasks[status] || []).forEach(task => { %>
                    <article class="kanban-card" draggable="true" data-task-id="<%= task._id %>">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <span class="badge bg-primary-subtle text-primary"><%= task.priority %></span>
                            <a href="/tasks/edit/<%= task._id %>" class="text-muted">
                                <i data-feather="edit-2" style="width: 16px;"></i>
                            </a>
                        </div>
                        <h6 class="fw-bold mb-2"><%= task.title %></h6>
                        <p class="text-muted small mb-3"><%= (task.description || '').replace(/<[^>]*>?/gm, '').slice(0, 110) || 'No description added.' %></p>
                        <div class="small text-muted d-flex flex-column gap-1">
                            <span><i data-feather="user" style="width: 14px;"></i> <%= task.assignedTo ? task.assignedTo.name : 'Unassigned' %></span>
                            <span><i data-feather="calendar" style="width: 14px;"></i> <%= task.deadline ? new Date(task.deadline).toLocaleDateString() : 'No deadline' %></span>
                        </div>
                    </article>
                <% }) %>
            </div>
        </section>
    <% }) %>
</div>
